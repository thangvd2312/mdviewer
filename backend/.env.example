PORT=9000
# Where the React app runs. Used for CORS and for redirecting back after GitHub login.
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=viewmd
DB_PASSWORD=viewmd
DB_NAME=viewmd
# Auto-create tables from entities. Keep true for local dev only; use migrations in production.
DB_SYNC=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# GitHub OAuth App — create one at https://github.com/settings/applications/new
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Reading assistant — any OpenAI-compatible Chat Completions endpoint.
# Leave ASSISTANT_API_KEY empty to disable the assistant.
ASSISTANT_BASE_URL=https://9router.tidesquare.vn/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=cx/gpt-6.1-sol
# Reasoning effort for chat answers: low | medium | high (suggestions always use low)
ASSISTANT_EFFORT=high
# Fallbacks, "model[:effort]" comma-separated: tried in order when a model fails before answering
# (provider quota used up, outage). The saver tier keeps its low effort on fallbacks.
ASSISTANT_FALLBACK_MODELS=ag/claude-opus-5-5-high:xhigh,ag/gemini-4-argon-high:high,minimax/MiniMax-M3:high

# Limits (defaults shown). Allowances reset at midnight in ASSISTANT_TIMEZONE.
# Per user per day: ASSISTANT_DAILY_FULL questions on ASSISTANT_MODEL, then ASSISTANT_DAILY_SAVER
# on the cheaper ASSISTANT_SAVER_MODEL, then none until midnight.
ASSISTANT_SAVER_MODEL=cx/gpt-6-luna
ASSISTANT_SAVER_EFFORT=low
ASSISTANT_DAILY_FULL=30
ASSISTANT_DAILY_SAVER=50
# Suggested-question generations per user per day (always on the saver model, cached 30 min)
ASSISTANT_DAILY_SUGGEST=100
# Token ceiling per user per day (prompt + answer); 0 = none
ASSISTANT_USER_DAILY_TOKENS=2000000
# Token budget for everyone together per day; past ASSISTANT_GLOBAL_SAVER_AT of it everyone
# gets the saver model, past all of it the assistant pauses until midnight. 0 = none
ASSISTANT_GLOBAL_DAILY_TOKENS=20000000
ASSISTANT_GLOBAL_SAVER_AT=0.7
# Questions per user per minute (one answer at a time regardless)
ASSISTANT_PER_MINUTE=5
# Answers longer than this many characters are cut off
ASSISTANT_MAX_ANSWER_CHARS=12000
ASSISTANT_TIMEZONE=Asia/Ho_Chi_Minh
# GitHub logins or emails with no per-user allowance (the global budget still applies)
ASSISTANT_UNLIMITED_USERS=

# Public pages & comments
# IP address and user agent are erased from comments after this many days (the short device label stays)
COMMENT_IP_RETENTION_DAYS=90
# Extra origins allowed to post comments, comma-separated (FRONTEND_URL is always allowed)
ALLOWED_ORIGINS=
