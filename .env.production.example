# Production config — copy to .env in the app directory on the server (never commit it).
PORT=4100
HOST=127.0.0.1                     # only cloudflared on this machine talks to the app
FRONTEND_URL=https://mdviewer.thangvu.io.vn

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mdviewer
DB_USER=mdviewer
DB_PASSWORD=
DB_SYNC=false                      # never auto-sync in production…
DB_MIGRATIONS_RUN=true             # …apply backend/src/migrations on startup instead

JWT_SECRET=                        # openssl rand -hex 32
JWT_EXPIRES_IN=7d

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://mdviewer.thangvu.io.vn/api/auth/github/callback
