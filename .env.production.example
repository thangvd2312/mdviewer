# Production config: every variable the app reads. In k3s these live in the Secret apps/mdviewer-env (docs/DEPLOY.md).
# Never commit real values.
PORT=4100                          # k3s: not set, the image defaults to 4100
HOST=0.0.0.0                       # k3s: listen on the pod IP (cloudflared reaches it through the Service)
FRONTEND_URL=https://mdviewer.thangvu.io.vn

DB_HOST=mysql.apps.svc.cluster.local
DB_PORT=3306
DB_NAME=mdviewer
DB_USER=mdviewer
DB_PASSWORD=
DB_SYNC=false                      # never auto-sync in production…
DB_MIGRATIONS_RUN=true             # …apply backend/src/migrations on startup instead

JWT_SECRET=                        # openssl rand -hex 32
JWT_EXPIRES_IN=7d

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://mdviewer.thangvu.io.vn/api/auth/github/callback

ASSISTANT_BASE_URL=https://9router.tidesquare.vn/v1   # any OpenAI-compatible endpoint
ASSISTANT_API_KEY=                 # reading assistant; empty = disabled
ASSISTANT_MODEL=cx/gpt-6.1-sol
ASSISTANT_EFFORT=high              # low | medium | high
ASSISTANT_FALLBACK_MODELS=ag/claude-opus-5-5-high:xhigh,ag/gemini-4-argon-high:high,minimax/MiniMax-M3:high
# Limits — see backend/.env.example for all of them and their defaults
ASSISTANT_SAVER_MODEL=cx/gpt-6-luna
ASSISTANT_DAILY_FULL=30            # per user per day on ASSISTANT_MODEL…
ASSISTANT_DAILY_SAVER=50           # …then this many on the saver model, then none until midnight
ASSISTANT_GLOBAL_DAILY_TOKENS=20000000
ASSISTANT_UNLIMITED_USERS=thangvd2312
COMMENT_IP_RETENTION_DAYS=90       # erase commenters' IP/user agent after this many days
# Other sites that may use the API from a browser (CORS) and receive a GitHub login: a local frontend
# whose frontend/.env has VITE_API_URL=https://apimdviewer.thangvu.io.vn
ALLOWED_ORIGINS=http://localhost:5173
